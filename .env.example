# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Service role key, server-side only. This app uses it for all data access -
# see app/supabase_client.py for why that's a safe trade-off here.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Comma-separated list of emails allowed to log in. Anyone not on this list
# is turned away at /login, regardless of domain.
ALLOWED_LOGIN_EMAILS=

# Google AI Studio API key. Powers "New task from text" (app/gemini_client.py).
# Leave empty to disable that feature - the rest of the app works without it.
GEMINI_API_KEY=your-gemini-api-key

# Confirm this model id still exists at ai.google.dev before deploying -
# model names get revised. (Verified 12/08/2026 via /v1beta/models.)
GEMINI_MODEL=
